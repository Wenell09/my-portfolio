generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL_POOLED")
  directUrl = env("PRISMA_DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Profile {
  id              String   @id @default(cuid())
  name            String
  title           String
  description     String
  profileImageUrl String
  imageHint       String?
  email           String?
  linkedin        String?
  github          String?
  instagram       String?
  whatsapp        String?
  updatedAt       DateTime @updatedAt
}

enum ProjectCategory {
  MOBILE
  WEB
  BACKEND
  FULLSTACK
  OTHER
}

enum ProjectStatus {
  COMPLETED
  IN_PROGRESS
  ARCHIVED
}

model Project {
  id           String          @id @default(cuid())
  slug         String          @unique
  title        String
  description  String      
  features     String[]        // Array untuk bullet points "Fitur Utama"
  category     ProjectCategory @default(MOBILE)
  tags         String[]        // Tech stack: ["Flutter", "Golang", "PostgreSQL"]
  imageUrl     String          // Thumbnail utama
  imageHint    String?
  screenshots  String[]        // Array URL mockup tambahan untuk di halaman detail
  playstoreUrl String?
  githubUrl    String?
  demoUrl      String?
  status       ProjectStatus   @default(COMPLETED)
  isPublished  Boolean         @default(true) // Memisahkan status proyek (Completed/WIP) dengan status tayang web
  order        Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([category, isPublished, order])
}

model SkillCategory {
  id        String   @id @default(cuid())
  title     String
  icon      String
  order     Int      @default(0)
  skills    Skill[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id         String        @id @default(cuid())
  name       String
  iconUrl    String
  categoryId String
  category   SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  order      Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model Experience {
  id          String   @id @default(cuid())
  company     String
  category    String
  role        String
  period      String
  description String
  logoUrl     String
  logoHint    String?
  status      String   @default("published")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Certificate {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  fileUrl   String
  imageUrl  String
  tags      String[]
  status    String   @default("published")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}


model SocialLink {
  id        String   @id @default(cuid())
  platform  String
  url       String
  icon      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  id              String   @id @default("singleton")
  siteTitle       String   @default("My Portfolio")
  siteDescription String   @default("")
  footerText      String   @default("")
  updatedAt       DateTime @updatedAt
}
